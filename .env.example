# ===== 大模型配置（OpenAI 兼容协议）=====
# 复制本文件为 .env 并填入真实值

# 接口地址：按所用厂商填写
#   DeepSeek : https://api.deepseek.com/v1
#   通义千问  : https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi     : https://api.moonshot.cn/v1
#   OpenAI   : https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# API Key
OPENAI_API_KEY=sk-your-key-here

# 模型名：如 deepseek-chat / qwen-plus / moonshot-v1-8k / gpt-4o-mini
OPENAI_MODEL=deepseek-chat

# 采样温度（分析类任务建议 0.2-0.5，越低越稳定）
OPENAI_TEMPERATURE=0.3

# 单次请求超时（秒）
OPENAI_TIMEOUT=90

# JSON 修复重试次数
OPENAI_MAX_RETRIES=1

# 是否强制使用 response_format=json_object（部分国产模型不支持，可设 false）
OPENAI_USE_JSON_MODE=true

# ===== 成本估算（可选）=====
# 模型单价（美元 / 百万 token）。留空则按内置 KNOWN_PRICES 表自动匹配。
# OPENAI_PRICE_INPUT_PER_1M=0.10
# OPENAI_PRICE_OUTPUT_PER_1M=0.30

# ===== 输入预处理 =====
# raw_text 最大字符数，超出将截断（默认 3000）
MAX_RAW_TEXT_CHARS=3000

# ===== 结构化日志 =====
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志目录（相对项目根目录），产出 hotspot_analysis.log（JSON 行，自动轮转）
LOG_DIR=logs

# ===== 离线 Mock 模式 =====
# 设为 true 时不发起真实请求，直接读取示例数据，实现秒级零成本调优
MOCK_MODE=false
# 自定义 Mock 数据文件（默认 examples/sample_output.json）
# MOCK_FILE=examples/sample_output.json
